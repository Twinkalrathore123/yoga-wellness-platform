# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas (free cloud tier) connection string — get one at mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# For a LOCAL MongoDB install instead, use: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://your_username:your_password@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=yoga_platform

GROQ_API_KEY=your-groq-api-key-here
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
